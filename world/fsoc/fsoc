#!/bin/bash
# fsoc - fsociety's toolkit. A tiny package manager for this box.
#
# Tools live off-PATH in /opt/fsoc/bin; `fsoc install <tier>` exposes a tier's
# tools (symlinks into ~/.local/bin) and wires their shell integration. Bare
# by default so the wargame stays honest; each tier is opt-in. Per-node: what
# you install here stays on this box.
set -u

FSOC_BIN=/opt/fsoc/bin
FRAG=/opt/fsoc/frag
LOCALBIN="$HOME/.local/bin"
STATE="$HOME/.fsoc"
ACTIVE="$STATE/active"
INIT="$STATE/init.bash"

AMBER=$'\e[38;5;179m'; RED=$'\e[38;5;196m'; DIM=$'\e[38;5;242m'; GRN=$'\e[38;5;71m'; RST=$'\e[0m'

tier_tools() {
    case "$1" in
        cosmetic) echo "starship bat glow gum tldr fastfetch" ;;
        comfort)  echo "fzf zoxide yazi atuin dust" ;;
        power)    echo "eza rg fd sd lazygit" ;;
        dev)      echo "mise gh" ;;
        *)        echo "" ;;
    esac
}
TIERS="cosmetic comfort power dev"

tier_blurb() {
    case "$1" in
        cosmetic) echo "prompt, colours, nicer viewing. no effect on the puzzles." ;;
        comfort)  echo "fuzzy find, jumps, file manager. eases work, hands you nothing." ;;
        power)    echo "rg/fd/eza/lazygit. shortcuts the search, find and git jobs. assisted mode." ;;
        dev)      echo "mise + gh + runtimes. build tooling, irrelevant to the jobs." ;;
    esac
}

ensure_state() { mkdir -p "$STATE" "$LOCALBIN"; touch "$ACTIVE"; }
is_active() { grep -qx "$1" "$ACTIVE" 2>/dev/null; }

regen_init() {
    local _t                         # local: must not clobber caller's $tier
    {
        echo "# generated by fsoc - do not edit"
        while read -r _t; do
            [ -z "$_t" ] && continue
            [ -r "$FRAG/$_t.bash" ] && cat "$FRAG/$_t.bash"
        done < "$ACTIVE"
    } > "$INIT"
}

status() {
    ensure_state
    printf '%sfsoc%s  fsociety toolkit\n' "$RED" "$RST"
    local any=0
    for tier in $TIERS; do
        if is_active "$tier"; then printf '  %s[on]%s  %-9s %s%s%s\n' "$GRN" "$RST" "$tier" "$DIM" "$(tier_blurb "$tier")" "$RST"; any=1
        else printf '  %s[  ]%s  %-9s %s%s%s\n' "$DIM" "$RST" "$tier" "$DIM" "$(tier_blurb "$tier")" "$RST"; fi
    done
    [ "$any" = 0 ] && printf '  %sbare. `fsoc install cosmetic` to start.%s\n' "$DIM" "$RST"
}

do_install() {
    local tier="$1"
    if [ "$tier" = "ai" ]; then
        printf '%s<darlene>%s no. do it yourself, friend. that is the whole point.\n' "$AMBER" "$RST"
        return 1
    fi
    if [ "$tier" = "all" ]; then for t in $TIERS; do do_install "$t"; done; return; fi
    local tools; tools=$(tier_tools "$tier")
    if [ -z "$tools" ]; then printf '%sunknown tier:%s %s   (try: %s)\n' "$RED" "$RST" "$tier" "$TIERS"; return 1; fi
    ensure_state
    local ok="" missing=""
    for t in $tools; do
        if [ -x "$FSOC_BIN/$t" ]; then ln -sf "$FSOC_BIN/$t" "$LOCALBIN/$t"; ok="$ok $t"
        else missing="$missing $t"; fi
    done
    is_active "$tier" || echo "$tier" >> "$ACTIVE"
    regen_init
    printf '%sinstalled%s %s:%s\n' "$GRN" "$RST" "$tier" "$ok"
    [ -n "$missing" ] && printf '%sunresolved (not in this build):%s%s\n' "$DIM" "$RST" "$missing"
    if [ "$tier" = "power" ]; then
        printf '%s<darlene>%s training wheels off, in reverse. you will skip the fundamentals.\n' "$AMBER" "$RST"
    fi
    if [ "$tier" = "dev" ]; then
        printf '%snote:%s language runtimes install via `mise use -g ...` and need network.\n' "$DIM" "$RST"
    fi
    printf '%srun `exec bash` to load it.%s\n' "$DIM" "$RST"
}

do_remove() {
    local tier="$1"; ensure_state
    local tools; tools=$(tier_tools "$tier")
    [ -z "$tools" ] && { printf 'unknown tier: %s\n' "$tier"; return 1; }
    grep -vx "$tier" "$ACTIVE" > "$ACTIVE.tmp" 2>/dev/null; mv "$ACTIVE.tmp" "$ACTIVE"
    # drop symlinks no longer owned by any active tier
    for t in $tools; do
        local still=0
        while read -r a; do case " $(tier_tools "$a") " in *" $t "*) still=1;; esac; done < "$ACTIVE"
        [ "$still" = 0 ] && rm -f "$LOCALBIN/$t"
    done
    regen_init
    printf 'removed %s. run `exec bash`.\n' "$tier"
}

reset_all() {
    ensure_state
    for tier in $TIERS; do for t in $(tier_tools "$tier"); do rm -f "$LOCALBIN/$t"; done; done
    : > "$ACTIVE"; regen_init
    printf 'back to bare. run `exec bash`.\n'
}

case "${1:-}" in
    ""|status)   status ;;
    list)        for t in $TIERS; do printf '%s%-9s%s %s\n' "$AMBER" "$t" "$RST" "$(tier_blurb "$t")"; done ;;
    install|add) shift; [ $# -eq 0 ] && { echo "usage: fsoc install <tier|all>"; exit 1; }; for t in "$@"; do do_install "$t"; done ;;
    remove|rm)   shift; [ $# -eq 0 ] && { echo "usage: fsoc remove <tier>"; exit 1; }; for t in "$@"; do do_remove "$t"; done ;;
    reset)       reset_all ;;
    *)           printf 'fsoc: unknown command %q\n  usage: fsoc [status|list|install <tier>|remove <tier>|reset]\n' "$1"; exit 1 ;;
esac
